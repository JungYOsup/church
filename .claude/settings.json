{
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Read(./.env)",
      "Read(./.env*.local)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git commit *--amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(rm *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 300,
            "statusMessage": "DoD 확인 중 (lint·build)"
          }
        ]
      }
    ]
  }
}
